# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules
# This project uses pnpm
package-lock.json

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Exclude files specific to personal development process
.hotreload
.devtarget
.env

# Conversion fixtures that cannot be committed - a user's export attached to an
# issue, typically. Drop one in tests/<importer>/local/ and its output is
# recorded beside it. See tests/helpers.ts.
tests/**/local/
